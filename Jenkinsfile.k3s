pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    environment {
        DOCKER_HUB_USER = 'aisharust94'

        IMAGE_API = "${DOCKER_HUB_USER}/fitflow-api"
        IMAGE_WORKER = "${DOCKER_HUB_USER}/fitflow-worker"
        IMAGE_FRONTEND = "${DOCKER_HUB_USER}/fitflow-frontend"

        K8S_NAMESPACE = 'default'
        CI_KUSTOMIZE = 'infrastructure/kubernetes/ci'
        APP_HEALTH_URL = 'http://10.8.0.1:30080/health'
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                deleteDir()
                checkout scm

                script {
                    def commit = sh(
                        script: 'git rev-parse --short=12 HEAD',
                        returnStdout: true
                    ).trim()

                    env.RELEASE_TAG = "k3s-${commit}-${env.BUILD_NUMBER}"
                }

                echo "Версия Kubernetes: ${env.RELEASE_TAG}"
            }
        }

        stage('Check Kubernetes access') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'k3s-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        set -eu

                        kubectl --request-timeout=15s \
                            -n "$K8S_NAMESPACE" get deployments

                        kubectl --request-timeout=15s \
                            -n "$K8S_NAMESPACE" auth can-i create deployments

                        kubectl --request-timeout=15s \
                            -n "$K8S_NAMESPACE" auth can-i patch deployments
                    '''
                }
            }
        }

        stage('Lint') {
            steps {
                sh '''
                    set -eu

                    source_archive="$(mktemp)"
                    trap 'rm -f "$source_archive"' EXIT

                    tar -C services/api -cf "$source_archive" .

                    docker run --rm -i \
                        --entrypoint sh \
                        pipelinecomponents/ruff:latest \
                        -c 'set -eu
                            mkdir -p /tmp/fitflow-source
                            tar -xf - -C /tmp/fitflow-source
                            cd /tmp/fitflow-source
                            ruff check .
                        ' < "$source_archive"
                '''
            }
        }

        stage('Build images') {
            steps {
                sh '''
                    set -eu
                    mkdir -p services/frontend/css \
                             services/frontend/js \
                             services/frontend/pages
                '''

                script {
                    docker.build(
                        "${IMAGE_API}:${env.RELEASE_TAG}",
                        './services/api'
                    )

                    docker.build(
                        "${IMAGE_WORKER}:${env.RELEASE_TAG}",
                        './services/worker'
                    )

                    docker.build(
                        "${IMAGE_FRONTEND}:${env.RELEASE_TAG}",
                        './services/frontend'
                    )
                }
            }
        }

        stage('Push images') {
            steps {
                script {
                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'dockerhub-credentials'
                    ) {
                        docker.image(
                            "${IMAGE_API}:${env.RELEASE_TAG}"
                        ).push()

                        docker.image(
                            "${IMAGE_WORKER}:${env.RELEASE_TAG}"
                        ).push()

                        docker.image(
                            "${IMAGE_FRONTEND}:${env.RELEASE_TAG}"
                        ).push()
                    }
                }
            }
        }

        stage('Prepare Kubernetes manifests') {
            steps {
                sh '''
                    set -eu

                    mkdir -p "$CI_KUSTOMIZE"

                    cat > "$CI_KUSTOMIZE/kustomization.yaml" <<EOF
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

resources:
  - ../apps

images:
  - name: ${IMAGE_API}
    newTag: "${RELEASE_TAG}"
  - name: ${IMAGE_WORKER}
    newTag: "${RELEASE_TAG}"
  - name: ${IMAGE_FRONTEND}
    newTag: "${RELEASE_TAG}"
EOF

                    kubectl kustomize "$CI_KUSTOMIZE" \
                        > rendered-k8s.yaml
                '''
            }
        }

        stage('Deploy Kubernetes') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'k3s-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        set -eu

                        kubectl --request-timeout=30s \
                            -n "$K8S_NAMESPACE" apply \
                            --dry-run=server \
                            -f rendered-k8s.yaml

                        kubectl --request-timeout=30s \
                            -n "$K8S_NAMESPACE" apply \
                            -f rendered-k8s.yaml
                    '''
                }
            }
        }

        stage('Verify rollout') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'k3s-kubeconfig',
                        variable: 'KUBECONFIG'
                    )
                ]) {
                    sh '''
                        set -eu

                        for deployment in \
                            fitflow-redis \
                            fitflow-api \
                            fitflow-worker \
                            fitflow-frontend
                        do
                            kubectl -n "$K8S_NAMESPACE" rollout status \
                                "deployment/$deployment" \
                                --timeout=300s
                        done

                        kubectl -n "$K8S_NAMESPACE" get deployments
                        kubectl -n "$K8S_NAMESPACE" get pods -o wide
                    '''
                }
            }
        }

        stage('Verify HTTP') {
            steps {
                sh '''
                    set -eu

                    curl \
                        --noproxy '*' \
                        --fail \
                        --silent \
                        --show-error \
                        --connect-timeout 5 \
                        --max-time 15 \
                        --retry 3 \
                        --retry-delay 5 \
                        --retry-connrefused \
                        "$APP_HEALTH_URL"
                '''
            }
        }
    }

    post {
        success {
            echo "Версия ${env.RELEASE_TAG} развёрнута в Kubernetes. Rollout и HTTP-проверка успешны."
        }

        failure {
            echo 'Pipeline завершился ошибкой. Посмотри первый упавший этап в Console Output.'
        }

        always {
            sh '''
                rm -rf infrastructure/kubernetes/ci
                rm -f rendered-k8s.yaml
            '''
        }
    }
}