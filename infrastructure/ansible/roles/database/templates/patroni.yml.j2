scope: fitflow-cluster
namespace: /db/
name: {{ inventory_hostname | to_json }}

restapi:
  listen: 0.0.0.0:8008
  connect_address: {{ (ansible_host ~ ':8008') | to_json }}

etcd3:
  host: 127.0.0.1:2379

bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    postgresql:
      use_pg_rewind: true
      parameters:
        wal_level: replica
        hot_standby: "on"
        max_wal_senders: 10
        max_replication_slots: 10

  initdb:
    - encoding: UTF8
    - data-checksums

  pg_hba:
    - local all postgres peer
    - host all all 127.0.0.1/32 scram-sha-256
    - host replication replicator 192.168.56.135/32 scram-sha-256
    - host replication replicator 192.168.56.140/32 scram-sha-256
    - host all all 10.8.0.1/32 scram-sha-256

postgresql:
  listen: 0.0.0.0:5432
  connect_address: {{ (ansible_host ~ ':5432') | to_json }}
  data_dir: /data/patroni
  bin_dir: /usr/lib/postgresql/15/bin
  pgpass: /var/lib/postgresql/.pgpass

  authentication:
{{ database_authentication | to_nice_yaml(indent=2) | indent(4, true) }}

  parameters:
    unix_socket_directories: /var/run/postgresql

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
  nosync: false