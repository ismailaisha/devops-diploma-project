[Interface]
PrivateKey = {{ wg_private_key }}
Address = {{ wireguard_ip }}/24
ListenPort = 51820

{% for peer in groups['azure'] + groups['local_vms'] %}
{% if peer != inventory_hostname %}
# {{ peer }}
[Peer]
PublicKey = {{ hostvars[peer]['wg_public_key'] }}
AllowedIPs = {{ hostvars[peer]['wireguard_ip'] }}/32
{% if peer in groups['azure'] %}
Endpoint = {{ hostvars[peer]['ansible_host'] }}:51820
PersistentKeepalive = 25
{% elif inventory_hostname in groups['local_vms'] %}
Endpoint = {{ hostvars[peer]['ansible_host'] }}:51820
PersistentKeepalive = 25
{% endif %}

{% endif %}
{% endfor %}