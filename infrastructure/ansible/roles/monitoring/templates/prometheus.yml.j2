global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

rule_files:
  - /etc/prometheus/rules/fitflow-alerts.yml

scrape_configs:
  # Метрики самого Prometheus.
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090

  # Системные метрики серверов через WireGuard.
  - job_name: node_exporter
    static_configs:
      - targets:
          - '{{ hostvars["app_server"]["wireguard_ip"] }}:9100'
        labels:
          host: app_server

      - targets:
          - '{{ hostvars["jenkins_server"]["wireguard_ip"] }}:9100'
        labels:
          host: jenkins_server

      - targets:
          - '{{ hostvars["pg_master"]["wireguard_ip"] }}:9100'
        labels:
          host: pg_master

      - targets:
          - '{{ hostvars["pg_replica"]["wireguard_ip"] }}:9100'
        labels:
          host: pg_replica

      - targets:
          - '{{ hostvars["monitoring_server"]["wireguard_ip"] }}:9100'
        labels:
          host: monitoring_server