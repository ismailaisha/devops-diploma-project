global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager:9093

scrape_configs:
  # Сам Prometheus
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  # App Server метрики
  - job_name: 'app_server'
    static_configs:
      - targets: ['{{ hostvars["app_server"]["ansible_host"] }}:8000']

  # Node exporter — системные метрики серверов
  - job_name: 'node_exporter'
    static_configs:
      - targets:
          - '{{ hostvars["app_server"]["ansible_host"] }}:9100'
          - '{{ hostvars["jenkins_server"]["ansible_host"] }}:9100'